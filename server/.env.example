# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/medical-interpreter
MONGODB_DB_NAME=medical-interpreter

# Server Configuration
PORT=5000
NODE_ENV=development

# Application Mode
MOCK_MODE=false

# Access control (required when MOCK_MODE=false; the server refuses to start without it)
APP_ACCESS_TOKEN=change-me-to-a-long-random-string

# Browser origins allowed to call the API, comma-separated (same-origin is always allowed)
CORS_ORIGINS=http://localhost:3000

# Rate limits per client per window
RATE_LIMIT_WINDOW_MS=60000
SESSION_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=60
