# This is the root .env file that can contain shared configuration

# OpenAI API Configuration (used by server)
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Configuration (used by server)
MONGODB_URI=mongodb://localhost:27017/medical-interpreter
MONGODB_DB_NAME=medical-interpreter

# Server Configuration
PORT=5000
NODE_ENV=development

# Application Mode
MOCK_MODE=false

# Client Configuration (these are prefixed with REACT_APP_ in client/.env)
# Included here for reference - duplicate as needed in client/.env
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_WS_URL=wss://api.openai.com
# REACT_APP_MOCK_MODE=false
